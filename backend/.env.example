# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/xsprint

# JWT Authentication (REQUIRED)
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=1d

# Admin Bootstrap (REQUIRED for first admin creation)
ADMIN_BOOTSTRAP_CODE=change-this-secret-code
ALLOW_MULTIPLE_ADMINS=false

# Security
BCRYPT_SALT_ROUNDS=10
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=5000

# Optional: Gemini AI (if using AI features)
GEMINI_API_KEY=your-gemini-api-key-here
