// 3. POST /api/fixtures/generate
app.post('/api/fixtures/generate', async (req, res) => {
  try {
    const { playerIds, eventId } = req.body;
    
    if (!playerIds || !eventId) {
      return res.status(400).json({ error: "Player IDs and Event ID are required" });
    }

    const fixtures = await generateKnockoutFixtures(playerIds, eventId);
    
    res.json({ 
      success: true, 
      count: fixtures.length, 
      fixtures 
    });
  } catch (error) {
    console.error('Error generating fixtures:', error);
    res.status(500).json({ error: "Failed to generate fixtures" });
  }
});

// 4. POST /api/schedule
app.post('/api/schedule', async (req, res) => {
  try {
    const { eventId, courtIds, startTime } = req.body;
    
    if (!eventId || !courtIds || !startTime) {
      return res.status(400).json({ error: "Event ID, Court IDs, and Start Time are required" });
    }

    const schedule = await scheduleMatches(eventId, courtIds, startTime);
    
    res.json({ 
      success: true, 
      count: schedule.length, 
      schedule 
    });
  } catch (error) {
    console.error('Error scheduling matches:', error);
    res.status(500).json({ error: "Failed to schedule matches" });
  }
});

// 5. POST /api/match-code/generate
app.post('/api/match-code/generate', async (req, res) => {
  try {
    const { fixtureId } = req.body;
    
    if (!fixtureId) {
      return res.status(400).json({ error: "Fixture ID is required" });
    }

    const code = await generateMatchCode(fixtureId);
    
    // Don't return the code in response for security
    res.json({ 
      success: true, 
      message: "Match code generated successfully",
      fixtureId: fixtureId
    });
  } catch (error) {
    console.error('Error generating match code:', error);
    res.status(500).json({ error: "Failed to generate match code" });
  }
});
// 6. POST /api/umpire/unlock
app.post('/api/umpire/unlock', async (req, res) => {
  try {
    const { fixtureId, code } = req.body;
    
    if (!fixtureId || !code) {
      return res.status(400).json({ error: "Fixture ID and Code are required" });
    }

    const result = await verifyMatchCode(fixtureId, code);
    
    if (result.valid) {
      // Generate a temporary access token (in a real app, use JWT)
      const token = crypto.randomBytes(32).toString('hex');
      
      // Store the token temporarily (with expiration)
      await db.collection('accessTokens').doc(token).set({
        fixtureId: fixtureId,
        valid: true,
        createdAt: admin.firestore.FieldValue.serverTimestamp(),
        expiresAt: admin.firestore.Timestamp.fromDate(
          new Date(Date.now() + 60 * 60 * 1000) // 1 hour
        )
      });
      
      res.json({ 
        success: true, 
        token: token,
        message: "Access granted"
      });
    } else {
      res.status(403).json({ 
        success: false, 
        error: result.msg 
      });
    }
  } catch (error) {
    console.error('Error verifying match code:', error);
    res.status(500).json({ error: "Verification failed" });
  }
});

// 7. POST /api/umpire/score
app.post('/api/umpire/score', async (req, res) => {
  try {
    const { token, fixtureId, score, winnerId } = req.body;
    
    if (!token || !fixtureId || !score || !winnerId) {
      return res.status(400).json({ error: "Token, Fixture ID, Score, and Winner ID are required" });
    }

    // Verify token
    const tokenDoc = await db.collection('accessTokens').doc(token).get();
    if (!tokenDoc.exists || !tokenDoc.data().valid) {
      return res.status(403).json({ error: "Invalid or expired token" });
    }

    // Update fixture with result
    const fixtureRef = db.collection('fixtures').doc(fixtureId);
    const fixtureDoc = await fixtureRef.get();
    
    if (!fixtureDoc.exists) {
      return res.status(404).json({ error: "Fixture not found" });
    }

    // Get player IDs
    const fixtureData = fixtureDoc.data();
    const player1Id = fixtureData.p1.id;
    const player2Id = fixtureData.p2.id;
    const loserId = (player1Id === winnerId) ? player2Id : player1Id;

    // Update fixture
    await fixtureRef.update({
      status: 'COMPLETED',
      winner: winnerId,
      score: score,
      completedAt: admin.firestore.FieldValue.serverTimestamp()
    });

    // Close the match code
    await db.collection('matchCodes').doc(fixtureId).update({
      active: false
    });

    // Update leaderboard
    await updateLeaderboard(fixtureData.eventId, winnerId, loserId);

    // Update next round fixtures if needed
    // (This is a simplified example - in a full implementation you'd need to calculate the next round)
    // For now, we'll just mark this match as completed

    res.json({ 
      success: true, 
      message: "Score recorded successfully",
      fixtureId: fixtureId
    });
  } catch (error) {
    console.error('Error recording score:', error);
    res.status(500).json({ error: "Failed to record score" });
  }
});
// 8. GET /api/leaderboard/:eventId
app.get('/api/leaderboard/:eventId', async (req, res) => {
  try {
    const { eventId } = req.params;
    
    const leaderboardRef = db.collection('leaderboards').doc(eventId);
    const leaderboardDoc = await leaderboardRef.get();
    
    if (!leaderboardDoc.exists) {
      return res.json({ 
        success: true, 
        leaderboard: [] 
      });
    }
    
    const leaderboard = leaderboardDoc.data();
    
    // Convert to array and sort by points
    const leaderboardArray = Object.keys(leaderboard).map(playerId => {
      const stats = leaderboard[playerId];
      return {
        playerId: playerId,
        wins: stats.wins,
        losses: stats.losses,
        points: stats.points
      };
    });
    
    // Sort by points (descending), then wins (descending)
    leaderboardArray.sort((a, b) => {
      if (b.points !== a.points) return b.points - a.points;
      return b.wins - a.wins;
    });
    
    // Add player details
    const detailedLeaderboard = await Promise.all(leaderboardArray.map(async (entry) => {
      const playerDoc = await db.collection('players').doc(entry.playerId).get();
      return {
        ...entry,
        name: playerDoc.data().name,
        clubId: playerDoc.data().clubId
      };
    }));
    
    res.json({ 
      success: true, 
      leaderboard: detailedLeaderboard 
    });
  } catch (error) {
    console.error('Error fetching leaderboard:', error);
    res.status(500).json({ error: "Failed to fetch leaderboard" });
  }
});

// 9. GET /api/schedule/:eventId
app.get('/api/schedule/:eventId', async (req, res) => {
  try {
    const { eventId } = req.params;
    
    const scheduleSnapshot = await db.collection('schedules')
      .where('eventId', '==', eventId)
      .orderBy('startTime')
      .get();
    
    const schedule = [];
    scheduleSnapshot.forEach(doc => {
      schedule.push({ id: doc.id, ...doc.data() });
    });
    
    res.json({ 
      success: true, 
      schedule 
    });
  } catch (error) {
    console.error('Error fetching schedule:', error);
    res.status(500).json({ error: "Failed to fetch schedule" });
  }
});

