generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  UMPIRE
  ORGANIZER
  VIEWER
}

enum MatchStatus {
  PENDING // Waiting for players
  READY // Players ready, waiting for schedule
  SCHEDULED // Time assigned
  ONGOING // Live
  COMPLETED // Done
  CANCELLED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(VIEWER)

  // Relations
  umpiredMatches     Match[]            @relation("Umpire")
  assignedMatchCodes MatchCode[]        @relation("AssignedUmpire")
  resultAudits       MatchResultAudit[]
  codeUsages         MatchCodeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id            String         @id @default(uuid())
  playerId      String         @unique @default(cuid()) // Unique player ID (e.g., XS-ABC123)
  name          String
  email         String?        @unique
  gender        String?
  weight        String?
  category      String?
  description   String?
  clubId        String?
  club          Club?          @relation(fields: [clubId], references: [id])
  registrations Registration[]
  lockers       Locker[] // Locker assignments
  stats         PlayerStats? // Overall statistics

  // Enhanced Fixture Engine fields
  elo    Int? // ELO rating for advanced seeding
  region String? // Geographic region for distribution optimization

  matchesAsA Match[] @relation("PlayerA")
  matchesAsB Match[] @relation("PlayerB")
  winnerOf   Match[] @relation("Winner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String?
  description String?
  players     Player[]
}

model Tournament {
  id        String   @id @default(uuid())
  name      String
  location  String?
  startDate DateTime
  endDate   DateTime
  events    Event[]
  courts    Court[]
  lockers   Locker[] // Locker assignments for this tournament
}

model Event {
  id            String         @id @default(uuid())
  name          String
  tournamentId  String
  sport         String         @default("Badminton")
  type          String         @default("KNOCKOUT") // KNOCKOUT or ROUND_ROBIN
  gender        String? // Men's, Women's, Mixed
  category      String? // U15, U18, Senior, etc.
  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches       Match[]
  rounds        Int?
  registrations Registration[]
  createdAt     DateTime       @default(now())
}

model Registration {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  seed     Int?

  @@unique([eventId, playerId])
}

model Court {
  id           String          @id @default(uuid())
  name         String
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id])
  schedule     ScheduleBlock[]
}

model Match {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  round       Int
  matchNumber Int // 1-indexed within the round

  playerAId String?
  playerA   Player? @relation("PlayerA", fields: [playerAId], references: [id])

  playerBId String?
  playerB   Player? @relation("PlayerB", fields: [playerBId], references: [id])

  winnerId String?
  winner   Player? @relation("Winner", fields: [winnerId], references: [id])

  // Umpire Assignment (Critical for Security)
  umpireId String?
  umpire   User?   @relation("Umpire", fields: [umpireId], references: [id])

  // Scoring & Metadata
  score    Json? // e.g. { sets: [{a: 21, b: 19}, {a: 15, b: 21}, {a: 21, b: 10}] }
  metadata Json? // { bestOf: 3, category: "U15" }
  status   MatchStatus @default(PENDING)

  // Enhanced Fixture Engine fields
  isLosersBracket Boolean @default(false) // For double elimination
  bracketPosition Int? // For advanced bracket tracking

  // Propagation Logic
  nextMatchId     String?
  nextMatch       Match?  @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches Match[] @relation("NextMatch")

  matchCode MatchCode?
  schedule  ScheduleBlock?

  // Audit Relations
  resultAudits MatchResultAudit[]
  codeUsages   MatchCodeUsage[]

  startTime DateTime? // Denormalized for quick access
  endTime   DateTime?

  updatedAt DateTime @updatedAt
}

model MatchCode {
  id               String   @id @default(cuid())
  matchId          String   @unique
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  assignedUmpireId String
  assignedUmpire   User     @relation("AssignedUmpire", fields: [assignedUmpireId], references: [id])
  codeHash         String
  isActive         Boolean  @default(true)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id])
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id])
  startTime DateTime
  endTime   DateTime
}

model Locker {
  id           String     @id @default(uuid())
  lockerNumber String
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sport        String // Only for Basketball, Cricket, Football
  assignedAt   DateTime   @default(now())

  @@unique([lockerNumber, tournamentId])
}

model PlayerStats {
  id           String   @id @default(uuid())
  playerId     String   @unique
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  totalMatches Int      @default(0)
  totalWins    Int      @default(0)
  totalLosses  Int      @default(0)
  totalPoints  Int      @default(0)
  winRate      Float    @default(0)
  updatedAt    DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(uuid())
  action    String
  details   String
  createdAt DateTime @default(now())
}

model MatchResultAudit {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String // e.g. 'SUBMIT_RESULT', 'EDIT_RESULT'
  payload   Json?
  createdAt DateTime @default(now())
}

model MatchCodeUsage {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  umpire    User?    @relation(fields: [umpireId], references: [id])
  umpireId  String?
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())
}

model FixtureSnapshot {
  id            String   @id @default(cuid())
  eventId       String
  snapshotData  Json // Stores complete fixture state for rollback
  fairnessScore Float?
  metadata      Json? // Additional info like format, options used
  createdBy     String? // User who created this snapshot
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}
