generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  UMPIRE
  VIEWER
}

enum MatchStatus {
  PENDING // Waiting for players
  READY // Players ready, waiting for schedule
  SCHEDULED // Time assigned
  ONGOING // Live
  COMPLETED // Done
  CANCELLED
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(VIEWER)

  // Relations
  umpiredMatches Match[] @relation("Umpire")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id            String         @id @default(uuid())
  name          String
  weight        String? // Weight category (e.g., "Lightweight", "Heavyweight")
  category      String? // Competition category (e.g., "U15", "U18", "Senior")
  description   String? // Additional player details
  clubId        String?
  club          Club?          @relation(fields: [clubId], references: [id])
  registrations Registration[]

  matchesAsA Match[] @relation("PlayerA")
  matchesAsB Match[] @relation("PlayerB")
  winnerOf   Match[] @relation("Winner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id      String   @id @default(uuid())
  name    String   @unique
  players Player[]
}

model Tournament {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  events    Event[]
  courts    Court[]
}

model Event {
  id            String         @id @default(uuid())
  name          String
  tournamentId  String
  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches       Match[]
  rounds        Int? // Total rounds depth
  registrations Registration[]
}

model Registration {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  seed     Int?

  @@unique([eventId, playerId])
}

model Court {
  id           String          @id @default(uuid())
  name         String
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id])
  schedule     ScheduleBlock[]
}

model Match {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  round       Int
  matchNumber Int // 1-indexed within the round

  playerAId String?
  playerA   Player? @relation("PlayerA", fields: [playerAId], references: [id])

  playerBId String?
  playerB   Player? @relation("PlayerB", fields: [playerBId], references: [id])

  winnerId String?
  winner   Player? @relation("Winner", fields: [winnerId], references: [id])

  // Umpire Assignment (Critical for Security)
  umpireId String?
  umpire   User?   @relation("Umpire", fields: [umpireId], references: [id])

  // Scoring & Metadata
  score    Json? // e.g. { sets: [{a: 21, b: 19}, {a: 15, b: 21}, {a: 21, b: 10}] }
  metadata Json? // { bestOf: 3, category: "U15" }
  status   MatchStatus @default(PENDING)

  // Propagation Logic
  nextMatchId     String?
  nextMatch       Match?  @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches Match[] @relation("NextMatch")

  matchCode MatchCode?
  schedule  ScheduleBlock?

  startTime DateTime? // Denormalized for quick access
  endTime   DateTime?

  updatedAt DateTime @updatedAt
}

model MatchCode {
  id        String   @id @default(uuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  codeHash  String
  isActive  Boolean  @default(true)
  expiresAt DateTime
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id])
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id])
  startTime DateTime
  endTime   DateTime
}

model AdminLog {
  id        String   @id @default(uuid())
  action    String
  details   String
  createdAt DateTime @default(now())
}
